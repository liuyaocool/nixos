#!/usr/bin/env bash
set -euo pipefail
if [ $# -lt 2 ]; then
    echo "用法: $0 <path1> <path2> ..."
    exit 1
fi

name="${1##*/}"
name="${name%.*}.merge.jpg"
imgs=("$@")
count=${#imgs[@]}

input_args=()
for img in "${imgs[@]}"; do
    input_args+=(-i "$img")
done

labels=""
for ((i = 0; i < count; i++)); do
    labels+="[${i}:v]"
done

ffmpeg "${input_args[@]}" -filter_complex "${labels}vstack=inputs=${count}[out]" -map "[out]" -q:v 1 "$name"
