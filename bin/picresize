#!/usr/bin/env bash
set -euo pipefail
if [ $# -lt 3 ]; then
    echo "用法: $0 <width:size> <height:size> <path1> <path2> ..."
    echo "	size >0   : 指定尺寸px"
    echo "	size = -1 : 保证宽高比，需width height其中一个>0"
    echo "	size = -2 : 保证宽高比，但转到偶数，需width height其中一个>0"
    exit 1
fi

w=$1
h=$2
shift 2

dir=imgff_resize
mkdir -p $dir

for file in "$@"; do
    name=$(basename "$file")
    name="${name%.*}.${w}_${h}.${file##*.}"
    ffmpeg -i "${file}" -vf "scale=${w}:${h}" -q:v 1 "${dir}/${name}"
done
