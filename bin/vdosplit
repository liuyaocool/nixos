#!/usr/bin/env bash
if [ $# -lt 3 ]; then
    echo "Usage: $0 <start> <end> <path1> <path2> ..."
    echo "    start   : 秒数 或 时间格式(hh:mm:ss)"
    echo "    end = 0 : 截取到结尾"
    echo "    end < 0 : 从结尾数向前的秒数，不支持时间格式"
    echo "    end > 0 : 同 start"
    exit 1
fi

add="sp_${1//:/.}_${2//:/.}"
start=${1}
end=${2}
shift 2

for file in "$@"; do
	if (( $end < 0 )); then
		dur=$(ffprobe -i "$file" -show_entries format=duration -v quiet -of csv="p=0")
		end=( -to $(( ${dur%%.*} + end )) )
	elif (( $end == 0 )); then
	    end=()
	else
		end=( -to $end )
	fi
	echo "$(vdo_get_out "$file" "$add")"
	echo end = $end
	ffmpeg -ss ${start} "${end[@]}" -i ${file} -c copy "$(vdo_get_out "$file" "$add")"
done
