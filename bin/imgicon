#!/usr/bin/env bash
if [ $# -lt 2 ]; then
    echo "Usage: $0 <width> <img_path...>"
    exit 1
fi
w="$1"
shift 1

for file in "$@"; do
    dir=$(dirname "$file")/icon
    name=$(basename "$file")
    name=${name%.*}
    mkdir -p $dir
    ffmpeg -i "${file}" -q 6 -vf "scale=${w}:-1" "${dir}/${name}.jpg"
done
